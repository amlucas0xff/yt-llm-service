# YT-LLM Service Configuration
# Copy this file to .env and modify the values as needed

# Core Hardware Configuration
DEVICE=cuda
# Options: cuda, cpu
# Use cuda for GPU acceleration, cpu for CPU-only processing

COMPUTE_TYPE=float16
# Options: float16, float32, int8
# float16 recommended for GPU, float32 for CPU

CUDA_VISIBLE_DEVICES=0
# GPU device ID to use (0 for first GPU)

# Whisper Model Configuration
WHISPER_MODEL=large-v3-turbo
# Options: tiny, base, small, medium, large, large-v2, large-v3, large-v3-turbo
# Larger models provide better accuracy but require more resources

BATCH_SIZE=16
# Processing batch size - adjust based on available GPU memory
# Recommended: 16 for high-end GPUs, 8 for mid-range, 4 for lower memory

# Authentication
HF_TOKEN=your_huggingface_token_here
# Required for accessing some models - get from https://huggingface.co/settings/tokens
# Leave empty if not needed

# Directory Paths
TEMP_DIR=/app/tmp
# Temporary directory for processing files

OUTPUT_DIR=/app/output
# Directory for saving transcription results

# Logging Configuration
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# LLM-Specific Configuration
LLM_OUTPUT_FORMAT=simple
# Options: simple, speaker, structured, markdown
# Default format for LLM-optimized transcriptions

LLM_REMOVE_FILLER_WORDS=false
# Remove common filler words (um, uh, etc.) from transcriptions

LLM_MERGE_CONSECUTIVE_SPEAKERS=true
# Merge consecutive segments from the same speaker

# TensorFlow Configuration
TF_CPP_MIN_LOG_LEVEL=2
# Suppress TensorFlow verbose logging

TF_FORCE_GPU_ALLOW_GROWTH=true
# Allow gradual GPU memory allocation

# Matplotlib Configuration (for containerized environments)
MPLCONFIGDIR=/home/app/.config/matplotlib

# Docker Volume Configuration
HOST_OUTPUT_DIR=/home/amlucas/Documents/obsidian/knowledge_base/llm-transcription/
# Local directory to mount as output directory in container

# Optional Browser Data Volumes (for YouTube cookie authentication)
# Uncomment and set these if you need browser cookie authentication
# HOST_FIREFOX_DIR=~/.mozilla/firefox
# HOST_CHROME_DIR=~/.config/google-chrome

# Development Settings (optional)
# DOCKER_BUILDKIT=1
# COMPOSE_DOCKER_CLI_BUILD=1